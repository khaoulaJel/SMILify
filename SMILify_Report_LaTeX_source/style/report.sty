%% ============================================================================
%%  report.sty -- layout for the SMILify internship report (<= 30 pages)
%%  Requirements: Calibri 12 pt, numbered pages, numbered + titled + cited
%%  figures and tables, front cover, back cover.
%%  Compile with XeLaTeX (fontspec). Calibri is used if installed; otherwise
%%  Carlito, which is metrically identical to Calibri, is used as fallback.
%% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{report}[2026/10/03 SMILify report style]

\RequirePackage{etoolbox}
\RequirePackage{iftex}
\RequirePackage{fontspec}
% 1) real Calibri (Windows font folder), 2) Carlito (metric-identical, Linux /
% Overleaf), 3) a system-installed Calibri found by name (e.g. macOS + Office).
% fontconfig on Linux aliases "Calibri" to Carlito, so the name lookup alone
% is not a reliable test there; hence the explicit file check first.
\IfFileExists{fonts/calibri.ttf}{%  (optional: put calibri*.ttf in a fonts/ folder)
  \setmainfont{calibri.ttf}[Path=fonts/,BoldFont=calibrib.ttf,
    ItalicFont=calibrii.ttf,BoldItalicFont=calibriz.ttf]%
  \setsansfont{calibri.ttf}[Path=fonts/,BoldFont=calibrib.ttf,
    ItalicFont=calibrii.ttf,BoldItalicFont=calibriz.ttf]%
}{\IfFileExists{C:/Windows/Fonts/calibri.ttf}{%
  \setmainfont{calibri.ttf}[Path=C:/Windows/Fonts/,BoldFont=calibrib.ttf,
    ItalicFont=calibrii.ttf,BoldItalicFont=calibriz.ttf]%
  \setsansfont{calibri.ttf}[Path=C:/Windows/Fonts/,BoldFont=calibrib.ttf,
    ItalicFont=calibrii.ttf,BoldItalicFont=calibriz.ttf]%
}{%
  \IfFontExistsTF{Carlito}{\setmainfont{Carlito}\setsansfont{Carlito}}{%
    \setmainfont{Calibri}\setsansfont{Calibri}}%
}}
\setmonofont{DejaVu Sans Mono}[Scale=MatchLowercase]

\RequirePackage[english]{babel}
\RequirePackage{csquotes}
\RequirePackage[protrusion=true,expansion=false]{microtype}
\RequirePackage{amsmath}
\newcommand{\bm}[1]{\symbfit{#1}}
\RequirePackage[dvipsnames]{xcolor}

\definecolor{ink}    {HTML}{000000}
\definecolor{graphite}{HTML}{444444}
\definecolor{rule}   {HTML}{BBBBBB}
\definecolor{accent} {HTML}{16506B}
\definecolor{adopt}  {HTML}{2F6B4F}
\definecolor{reject} {HTML}{8C3A2E}
\definecolor{hold}   {HTML}{8A6410}

\RequirePackage[a4paper,left=2.5cm,right=2.2cm,top=1.55cm,bottom=2.3cm,
  footskip=1.1cm,includehead,headheight=0.78cm,headsep=0.4cm]{geometry}

\linespread{1.05}
\setlength{\parindent}{0pt}
\setlength{\parskip}{3.5pt plus 1pt}
\frenchspacing
\raggedbottom

% -- headings (KOMA, Calibri bold) ------------------------------------------
\setkomafont{disposition}{\normalfont\bfseries}
\addtokomafont{section}{\fontsize{16}{19}\selectfont\color{accent}}
\addtokomafont{subsection}{\fontsize{13}{16}\selectfont\color{accent}}
\addtokomafont{subsubsection}{\normalsize\color{ink}}
\RedeclareSectionCommand[beforeskip=1.2\baselineskip,afterskip=0.5\baselineskip]{section}
\RedeclareSectionCommand[beforeskip=0.9\baselineskip,afterskip=0.3\baselineskip]{subsection}
\RedeclareSectionCommand[beforeskip=0.6\baselineskip,afterskip=0.2\baselineskip]{subsubsection}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}

% -- page numbers: centred footer, nothing in the header --------------------
\RequirePackage{scrlayer-scrpage}
\clearpairofpagestyles
\ihead*{\includegraphics[height=0.52cm]{figures/logos/juelich_blue.png}}
\ohead*{\includegraphics[height=0.6cm]{figures/logos/coc_dark.png}}
\KOMAoptions{headsepline=true}
\setkomafont{headsepline}{\color{rule}}
\cfoot*{\thepage}
\pagestyle{scrheadings}
\setkomafont{pagefoot}{\normalfont\normalsize}

% -- floats, tables, captions ----------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs,array,tabularx}
\RequirePackage{enumitem}
\setlist{noitemsep,topsep=2pt,leftmargin=1.5em}
\RequirePackage{float}
\RequirePackage{caption}
\captionsetup{font=normalsize,labelfont={bf,color=accent},labelsep=period,
  justification=justified,singlelinecheck=true,skip=5pt}
\captionsetup[table]{position=above,aboveskip=4pt,belowskip=4pt}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}
\renewcommand{\topfraction}{0.92}
\renewcommand{\bottomfraction}{0.85}
\renewcommand{\textfraction}{0.08}
\renewcommand{\floatpagefraction}{0.80}
\setlength{\textfloatsep}{10pt plus 2pt minus 2pt}
\setlength{\floatsep}{8pt plus 2pt minus 2pt}
\setlength{\intextsep}{8pt plus 2pt minus 2pt}
\renewcommand{\arraystretch}{1.12}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

\RequirePackage{url}
\RequirePackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true,linkcolor=accent,citecolor=accent,urlcolor=accent,
  linktoc=all,bookmarksnumbered=true,bookmarksopen=true,pdfcreator={},pdfproducer={}}
\RequirePackage{bookmark}
\urlstyle{same}

% -- maths: Latin Modern Math for symbols, text font for digits/punctuation --
% (stub: some TeX installations ship an old url.sty that unicode-math cannot patch)
\providecommand{\Url@FormatString}{}
\RequirePackage{unicode-math}
\setmathfont{latinmodern-math.otf}
\IfFileExists{C:/Windows/Fonts/calibri.ttf}{%
  \setmathfont[Path=C:/Windows/Fonts/,range={"0028-"0029,"002C,"002E,"0030-"0039,"005B,"005D}]{calibri.ttf}%
}{%
  \setmathfont[range={"0028-"0029,"002C,"002E,"0030-"0039,"005B,"005D}]{Carlito}%
}





% -- verdict words ----------------------------------------------------------
\newcommand{\verdict}[1]{\textbf{%
  \ifstrequal{#1}{ADOPT}{\textcolor{adopt}{#1}}{%
  \ifstrequal{#1}{REJECT}{\textcolor{reject}{#1}}{\textcolor{hold}{#1}}}}}

% -- findings ledger --------------------------------------------------------
% \DeclareFinding{id}{statement}{evidence}{status}; cite anywhere with \F{id};
% \printfindingledger prints the rows as the body of a tabular (the caller
% supplies the table float, caption and label).
\newcommand{\fnd@list}{}
\newcommand{\DeclareFinding}[4]{%
  \csdef{fnd@stmt@#1}{#2}\csdef{fnd@evid@#1}{#3}\csdef{fnd@stat@#1}{#4}%
  \listgadd{\fnd@list}{#1}}
\newcommand{\F}[1]{\hyperlink{fnd:#1}{\textcolor{accent}{\textbf{#1}}}}
\newcommand{\fnd@row}[1]{%
  \hypertarget{fnd:#1}{}\textbf{#1} & \csuse{fnd@stmt@#1} &
  \csuse{fnd@evid@#1} & \csuse{fnd@stat@#1} \\ \addlinespace[2pt]}
\newcommand{\printfindingledger}{%
  \begin{tabular}{@{}l L{0.37\linewidth} L{0.37\linewidth} L{0.13\linewidth}@{}}
  \toprule
  \textbf{ID} & \textbf{Finding} & \textbf{Evidence} & \textbf{Status}\\
  \midrule
  \forlistloop{\fnd@row}{\fnd@list}
  \bottomrule
  \end{tabular}}

\newcommand{\term}[1]{#1}
\newcommand{\code}[1]{{\ttfamily #1}}

\endinput
